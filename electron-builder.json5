{
  "appId": "com.devmanager.cockpit",
  "productName": "Dev Manager",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/onnxruntime-node/**/*",
    "node_modules/@anush008/tokenizers-*/**/*"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "publish": {
    "provider": "github",
    "owner": "wanderalvess",
    "repo": "dev-manager"
  }
}
