{
  "appId": "com.hubmanager.cockpit",
  "productName": "Hub Manager",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "electronDownload": {
    "strictSSL": false
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/**/*",
    "!node_modules/esbuild/**/*",
    "!node_modules/@esbuild/**/*",
    "package.json",
    "CHANGELOG.md",
    "docs/MCP_TOOLS.md"
  ],
  "asarUnpack": [
    "node_modules/onnxruntime-node/**/*",
    "node_modules/@anush008/tokenizers-*/**/*"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "requestedExecutionLevel": "asInvoker",
    "icon": "build/icon.ico",
    // Certificado interno autoassinado (dev-manager-codesign.pfx): só é "Valid" no Authenticode das máquinas
    // que importaram o .cer como Trusted Root; nas demais o electron-updater rejeitaria o download com
    // "not signed by the application owner". Com false o builder não grava o publisherName no app-update.yml
    // e o updater pula essa checagem (vale só para apps instalados a partir desta versão).
    // ATENÇÃO: o SHA-512 do latest.yml só garante integridade; quem publica na release controla o .exe e o hash.
    "verifyUpdateCodeSignature": false
  },
  // Nomes sem espaço: o GitHub troca espaço por "." no upload e o latest.yml (auto-update) deixaria de
  // achar o instalador. "Portable" no nome é como o app portátil acha o próprio .exe na release.
  "portable": {
    "artifactName": "HubManager-Portable-${version}.${ext}"
  },
  "nsis": {
    "artifactName": "HubManager-Setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    // Público brasileiro (WinThor): instalador sempre em pt-BR, sem depender do idioma do Windows.
    // ATENÇÃO: "multiLanguageInstaller": false força INGLÊS (o electron-builder usa só en_US nesse modo);
    // para fixar um idioma, liste-o em installerLanguages. "language" é só o LCID dos metadados do .exe.
    "language": "1046",
    "installerLanguages": ["pt_BR"],
    // Imagens com o logo atual, geradas por scripts/generate-icons.cjs a partir de public/icon.svg
    // (sidebar 164x314 na boas-vindas/conclusão, header 150x57 nas telas internas).
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallerSidebar": "build/installerSidebar.bmp",
    "installerHeader": "build/installerHeader.bmp",
    // Atalhos explícitos (os padrões já eram true): Desktop recriado só se ainda não existir, e Menu Iniciar
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hub Manager",
    "runAfterFinish": true
  },
  "publish": {
    "provider": "github",
    "owner": "wanderalvess",
    "repo": "dev-manager"
  }
}
