{
  "appId": "com.hubmanager.cockpit",
  "productName": "Hub Manager",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "electronDownload": {
    "strictSSL": false
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/**/*",
    "!node_modules/esbuild/**/*",
    "!node_modules/@esbuild/**/*",
    "package.json",
    "CHANGELOG.md",
    "docs/MCP_TOOLS.md"
  ],
  "asarUnpack": [
    "node_modules/onnxruntime-node/**/*",
    "node_modules/@anush008/tokenizers-*/**/*"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "requestedExecutionLevel": "asInvoker",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    // Público brasileiro (WinThor): instalador sempre em pt-BR, sem depender do idioma do Windows.
    // ATENÇÃO: "multiLanguageInstaller": false força INGLÊS (o electron-builder usa só en_US nesse modo);
    // para fixar um idioma, liste-o em installerLanguages. "language" é só o LCID dos metadados do .exe.
    "language": "1046",
    "installerLanguages": ["pt_BR"],
    // Atalhos explícitos (os padrões já eram true): Desktop recriado só se ainda não existir, e Menu Iniciar
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hub Manager",
    "runAfterFinish": true
  },
  "publish": {
    "provider": "github",
    "owner": "wanderalvess",
    "repo": "dev-manager"
  }
}
