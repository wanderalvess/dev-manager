{
  "name": "dev-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "Cockpit e Painel de Automação para Desenvolvedores e Apache Karaf OSGi",
  "main": "dist-electron/main/index.js",
  "author": "Wanderson Alves",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "npm run build && node scripts/build-electron.cjs",
    "pack": "npm run build && node scripts/build-electron.cjs --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "server": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "docker:build": "docker build -t dev-manager:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "fastembed": "^2.1.0",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.12.2",
    "mysql2": "^3.12.0",
    "node-cron": "^4.6.0",
    "oracledb": "^6.7.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.18",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": ">=6.16.0",
    "tar": "^7.5.21",
    "builder-util-runtime": "^9.7.0"
  }
}
