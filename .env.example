# =========================================================
# Variáveis de Ambiente para Docker e Compose
# =========================================================

# Porta do Painel Web Cockpit
PORT=3000

# Chave de API para proteger o painel (rotas /api/*) quando exposto além de localhost.
# Se definida, o navegador pedirá essa chave na primeira requisição (header x-api-key).
# OBRIGATÓRIA quando HOST não é 127.0.0.1/localhost (ex: no Docker, onde HOST=0.0.0.0) —
# este painel executa comandos do SO e consultas de banco, então o servidor recusa
# iniciar sem API_KEY nesse caso. Gere um valor forte, ex: openssl rand -hex 32
API_KEY=

# Caminhos no computador host (Windows / Linux / macOS)
# Exemplo Windows: C:/Users/seu.usuario/projetos ou /c/Users/...
HOST_PROJECTS_DIR=C:/Users/seu.usuario/projetos
HOST_KARAF_DIR=C:/karaf
HOST_APP_DIR=./app

# Credenciais do Apache Karaf
KARAF_USER=admin
KARAF_PASS=changeme

# Branch padrão para criação de Pull Requests no Azure DevOps
TARGET_PR_BRANCH=develop

# Credenciais para contêiner Oracle DB (quando ativado o perfil full-stack)
ORACLE_PASSWORD=changeme
DB_USER=APPUSER
DB_PASSWORD=changeme
