# =========================================================
# Variáveis de Ambiente para Docker e Compose
# =========================================================

# Porta do Painel Web Cockpit
PORT=3000

# Caminhos no computador host (Windows / Linux / macOS)
# Exemplo Windows: C:/Users/seu.usuario/projetosTOTVS ou /c/Users/...
HOST_PROJECTS_DIR=C:/Users/seu.usuario/projetosTOTVS
HOST_KARAF_DIR=C:/pcsist/produtos/winthor
HOST_WINTHOR_DIR=C:/Winthor

# Credenciais do Apache Karaf
KARAF_USER=winthor
KARAF_PASS=winthor

# Branch padrão para criação de Pull Requests no Azure DevOps
TARGET_PR_BRANCH=develop

# Credenciais para contêiner Oracle DB (quando ativado o perfil full-stack)
ORACLE_PASSWORD=winthor
DB_USER=WINTHOR
DB_PASSWORD=winthor
